<% page_title @course.title %>
<% content_for :description, @course.summary.to_s.truncate(160) %>
<article>
  <header class="border-b border-line bg-white">
    <div class="container-page py-10">
      <nav aria-label="Fil d'Ariane" class="mb-4 text-sm"><%= link_to "Formations", courses_path %> <span aria-hidden="true">/</span> <span class="text-ink-soft"><%= @course.category %></span></nav>
      <h1 class="max-w-[22ch]"><%= @course.title %></h1>
      <% if @course.subtitle.present? %><p class="mt-3 text-lg text-ink-soft measure"><%= @course.subtitle %></p><% end %>
      <p class="mt-4 text-sm text-ink-soft">Fiche mise à jour le <%= l(@course.info_updated_at.to_date, format: :long) if @course.info_updated_at %>.</p>
    </div>
  </header>

  <div class="container-page grid gap-10 py-10 lg:grid-cols-[1fr_22rem]">
    <div class="min-w-0 space-y-10">
      <section aria-labelledby="resume">
        <h2 id="resume" class="mb-3">En bref</h2>
        <div class="measure"><%= simple_format_text @course.summary %></div>
        <% if @course.description.present? %><div class="prose-copas mt-4"><%= @course.description %></div><% end %>
      </section>

      <section aria-labelledby="objectifs">
        <h2 id="objectifs" class="mb-3">Ce que vous saurez faire</h2>
        <ol class="space-y-3 measure">
          <% @course.objectives.each_with_index do |objective, i| %>
            <li class="flex gap-3">
              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-canard-light text-sm font-bold text-canard-dark"><%= i + 1 %></span>
              <div>
                <p class="font-bold"><%= objective.description %></p>
                <% if objective.success_criterion.present? %><p class="text-sm text-ink-soft">Évalué par : <%= objective.success_criterion %></p><% end %>
              </div>
            </li>
          <% end %>
        </ol>
      </section>

      <section aria-labelledby="programme">
        <h2 id="programme" class="mb-1">Programme</h2>
        <p class="mb-4 text-ink-soft">Durée moyenne de chaque activité à distance, telle que nous l'avons mesurée.</p>
        <ol class="divide-y divide-line border-y border-line">
          <% @course.lessons.each_with_index do |lesson, i| %>
            <li class="flex items-start justify-between gap-4 py-3">
              <div>
                <p class="font-bold"><span class="text-ink-soft"><%= i + 1 %>.</span> <%= lesson.title %></p>
                <% if lesson.summary.present? %><p class="text-sm text-ink-soft"><%= lesson.summary %></p><% end %>
              </div>
              <span class="whitespace-nowrap text-sm text-ink-soft"><%= minutes_label lesson.estimated_minutes %></span>
            </li>
          <% end %>
          <% if @course.final_assessment %>
            <li class="flex justify-between gap-4 py-3"><p class="font-bold">Évaluation finale des acquis</p><span class="text-sm text-ink-soft">QCM noté</span></li>
          <% end %>
        </ol>
      </section>

      <section aria-labelledby="modalites">
        <h2 id="modalites" class="mb-4">Modalités</h2>
        <dl class="facts">
          <dt>Public</dt><dd><%= simple_format_text @course.target_audience %></dd>
          <dt>Prérequis</dt><dd><%= simple_format_text @course.prerequisites %></dd>
          <dt>Outils numériques</dt><dd><%= simple_format_text @course.digital_requirements %></dd>
          <dt>Méthodes</dt><dd><%= simple_format_text @course.pedagogical_methods %></dd>
          <dt>Évaluation</dt><dd><%= simple_format_text @course.evaluation_methods %></dd>
          <dt>Assistance</dt><dd><%= simple_format_text @course.support_details %></dd>
          <dt>Accessibilité</dt><dd><%= simple_format_text @course.accessibility %> <%= link_to "Notre politique d'accessibilité", page_path("accessibilite") %></dd>
          <dt>Reconnaissance</dt><dd><%= @course.recognition %></dd>
          <% if @course.pedagogical_referent %><dt>Référent pédagogique</dt><dd><%= @course.pedagogical_referent.full_name %></dd><% end %>
        </dl>
      </section>

      <section aria-labelledby="resultats">
        <h2 id="resultats" class="mb-1">Résultats de cette formation</h2>
        <p class="mb-4 text-ink-soft">Période <%= @indicators.period_label %>. Chaque chiffre est calculé automatiquement à partir des parcours réels.</p>
        <% indicators = @indicators.all %>
        <% if @indicators.effectif.value < CourseIndicators::MIN_BASE %>
          <p class="panel-tint p-4 measure">Cette formation est récente : les indicateurs seront publiés à partir de <%= CourseIndicators::MIN_BASE %> apprenants, pour qu'ils soient significatifs.</p>
        <% else %>
          <dl class="grid gap-4 sm:grid-cols-2">
            <% indicators.each do |indicator| %>
              <div class="panel p-4">
                <dt class="text-sm text-ink-soft"><%= indicator.label %></dt>
                <dd class="m-0 font-display text-3xl font-bold"><%= indicator.value %><span class="text-lg font-normal"><%= indicator.unit %></span></dd>
                <dd class="m-0 mt-1 text-sm text-ink-soft"><%= "Base : #{indicator.base}. " if indicator.base %><%= indicator.formula %></dd>
              </div>
            <% end %>
          </dl>
        <% end %>
      </section>
    </div>

    <aside class="order-first lg:order-last lg:sticky lg:top-6 lg:self-start" aria-label="Inscription">
      <div class="panel panel-body">
        <p class="font-display text-2xl font-bold"><%= price_label(@course) %></p>
        <% if @course.pricing_details.present? %><p class="text-sm text-ink-soft"><%= @course.pricing_details %></p><% end %>
        <dl class="facts mt-5 text-sm">
          <dt>Durée</dt><dd><%= hours_label @course.duration_hours %><%= " – #{@course.duration_details}" if @course.duration_details.present? %></dd>
          <dt>Format</dt><dd><%= Course::MODALITY_LABELS[@course.modality] %></dd>
          <dt>Niveau</dt><dd><%= Course::LEVEL_LABELS[@course.level] %></dd>
          <dt>Délai d'accès</dt><dd><%= @course.access_delay %></dd>
          <dt>Financement</dt><dd><%= simple_format_text @course.funding_options %></dd>
          <dt>Contact</dt><dd><%= mail_to @course.contact_email %></dd>
        </dl>
        <div class="mt-6">
          <% if @enrollment %>
            <p class="mb-3"><%= status_badge @enrollment.status_label, enrollment_tone(@enrollment) %></p>
            <%= link_to "Accéder à mon parcours", enrollment_path(@enrollment), class: "btn btn-primary w-full" unless @enrollment.requested? || @enrollment.declined? %>
            <%= link_to "Voir ma demande", dashboard_path, class: "btn btn-secondary w-full" if @enrollment.requested? %>
          <% else %>
            <%= link_to "Demander une inscription", new_course_enrollment_request_path(@course), class: "btn btn-primary w-full" %>
            <p class="mt-3 text-sm text-ink-soft">Sans engagement : nous étudions votre demande et vous proposons une convention ou un devis.</p>
          <% end %>
        </div>
      </div>
    </aside>
  </div>
</article>
