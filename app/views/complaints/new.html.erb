<% report = @complaint.report? %>
<% page_title(report ? "Signalement confidentiel" : "Réclamation ou difficulté") %>
<section class="container-page py-10">
  <div class="measure">
    <h1><%= report ? "Signaler une situation de violence, de harcèlement ou de discrimination" : "Nous faire part d'une réclamation ou d'une difficulté" %></h1>
    <% if report %>
      <p class="mt-4 text-lg text-ink-soft">Votre signalement est transmis au seul référent désigné par COPAS. Il est traité de façon confidentielle et vous recevez un accusé de réception. <%= link_to "Lire notre procédure", page_path("prevention-violences") %>.</p>
      <p class="mt-3 panel-tint p-4">En cas de danger immédiat, appelez le 17 (police) ou le 112. Le 3919 écoute les femmes victimes de violences, gratuitement, 24 h/24.</p>
    <% else %>
      <p class="mt-4 text-lg text-ink-soft">Chaque demande reçoit un numéro, un accusé de réception immédiat et une réponse écrite. Elle nourrit notre démarche d'amélioration.</p>
    <% end %>
  </div>

  <%= form_with model: @complaint, url: complaints_path, class: "mt-8 measure" do |f| %>
    <%= render "shared/form_errors", record: @complaint %>
    <div class="field">
      <%= f.label :category, "Type de demande", class: "label" %>
      <%= f.select :category, Complaint::CATEGORY_LABELS.invert, {}, class: "input" %>
    </div>
    <% if user_signed_in? && current_user.courses.any? %>
      <div class="field">
        <%= f.label :course_id, "Formation concernée (facultatif)", class: "label" %>
        <%= f.collection_select :course_id, current_user.courses, :id, :title, { include_blank: "Aucune en particulier" }, class: "input" %>
      </div>
    <% end %>
    <div class="grid gap-x-4 sm:grid-cols-2">
      <div class="field"><%= f.label :name, "Nom", class: "label" %><%= f.text_field :name, class: "input", required: true, autocomplete: "name" %></div>
      <div class="field"><%= f.label :email, "Courriel", class: "label" %><%= f.email_field :email, class: "input", required: true, autocomplete: "email" %></div>
    </div>
    <div class="field">
      <%= f.label :description, "Décrivez la situation", class: "label" %>
      <%= f.text_area :description, class: "input", rows: 8, required: true %>
    </div>
    <%= f.submit "Envoyer", class: "btn btn-primary" %>
  <% end %>
</section>
