<p>Nouvelle demande au registre : <strong><%= @complaint.category_label %></strong>, n° <%= @complaint.reference %>.</p>
<% unless @complaint.report? %><p>De : <%= @complaint.name %> (<%= @complaint.email %>)</p><% end %>
<p><a href="<%= admin_complaint_url(@complaint) %>" style="display:inline-block;background:#0F5C6E;color:#ffffff;padding:10px 18px;border-radius:6px;text-decoration:none;font-weight:bold">Ouvrir dans l'espace de gestion</a></p>
