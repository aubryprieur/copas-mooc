<% page_title "Courriel et mot de passe" %>
<section class="container-page py-10">
  <div class="measure">
    <nav class="mb-4 text-sm"><%= link_to "Mon profil", edit_profile_path %></nav>
    <h1 class="text-3xl">Courriel et mot de passe</h1>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "mt-8" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div class="field"><%= f.label :email, "Courriel", class: "label" %><%= f.email_field :email, autocomplete: "email", class: "input" %>
        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %><p class="hint">En attente de confirmation : <%= resource.unconfirmed_email %></p><% end %></div>
      <div class="field"><%= f.label :password, "Nouveau mot de passe (laisser vide pour le conserver)", class: "label" %><%= f.password_field :password, autocomplete: "new-password", class: "input" %></div>
      <div class="field"><%= f.label :password_confirmation, "Confirmer le nouveau mot de passe", class: "label" %><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input" %></div>
      <div class="field"><%= f.label :current_password, "Mot de passe actuel (obligatoire pour valider)", class: "label" %><%= f.password_field :current_password, autocomplete: "current-password", class: "input", required: true %></div>
      <%= f.submit "Enregistrer", class: "btn btn-primary" %>
    <% end %>
    <section class="mt-12 border-t border-line pt-6">
      <h2 class="text-lg">Supprimer mon compte</h2>
      <p class="mt-2 text-sm text-ink-soft">Si vous avez suivi une formation, votre dossier est conservé le temps légal exigé par les financeurs, puis supprimé. Écrivez-nous à <%= mail_to org[:email] %> pour exercer vos droits.</p>
    </section>
  </div>
</section>
