<% page_title "Mot de passe oublié" %>
<%= render layout: "devise/shared/auth" do %>
  <h1 class="text-3xl">Mot de passe oublié</h1>
  <p class="mt-2 text-ink-soft">Indiquez votre courriel : si un compte existe, vous recevrez un lien pour choisir un nouveau mot de passe.</p>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-8 max-w-md" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="field"><%= f.label :email, "Courriel", class: "label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input", required: true %></div>
    <%= f.submit "Recevoir le lien", class: "btn btn-primary" %>
  <% end %>
  <%= render "devise/shared/links" %>
<% end %>
