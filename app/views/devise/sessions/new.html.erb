<% page_title "Se connecter" %>
<%= render layout: "devise/shared/auth" do %>
  <h1 class="text-3xl">Se connecter</h1>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 max-w-md" }) do |f| %>
    <div class="field"><%= f.label :email, "Courriel", class: "label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input", required: true %></div>
    <div class="field"><%= f.label :password, "Mot de passe", class: "label" %><%= f.password_field :password, autocomplete: "current-password", class: "input", required: true %></div>
    <% if devise_mapping.rememberable? %>
      <label class="field flex items-center gap-2"><%= f.check_box :remember_me, class: "checkbox" %> Rester connecté sur cet appareil</label>
    <% end %>
    <%= f.submit "Se connecter", class: "btn btn-primary" %>
  <% end %>
  <%= render "devise/shared/links" %>
<% end %>
