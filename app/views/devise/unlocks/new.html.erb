<% page_title "Débloquer mon compte" %>
<%= render layout: "devise/shared/auth" do %>
  <h1 class="text-3xl">Débloquer mon compte</h1>
  <p class="mt-2 text-ink-soft">Après plusieurs essais de mot de passe infructueux, le compte est bloqué 30 minutes. Vous pouvez aussi recevoir un lien de déblocage.</p>
  <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "mt-8 max-w-md" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="field"><%= f.label :email, "Courriel", class: "label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %></div>
    <%= f.submit "Recevoir le lien", class: "btn btn-primary" %>
  <% end %>
  <%= render "devise/shared/links" %>
<% end %>
