<% page_title "Confirmer mon courriel" %>
<%= render layout: "devise/shared/auth" do %>
  <h1 class="text-3xl">Renvoyer le courriel de confirmation</h1>
  <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "mt-8 max-w-md" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="field"><%= f.label :email, "Courriel", class: "label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input", value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email) %></div>
    <%= f.submit "Renvoyer", class: "btn btn-primary" %>
  <% end %>
  <%= render "devise/shared/links" %>
<% end %>
