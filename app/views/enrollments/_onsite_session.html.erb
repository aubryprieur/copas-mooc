<% slots = cs.slots.includes(:attendances) %>
<% today_slot = slots.find { |s| s.signing_window_open? } %>
<% if today_slot && !cs.attendance_photo? && !today_slot.attendances.find { _1.enrollment_id == enrollment.id }&.attended? %>
  <div class="mb-8 flex flex-wrap items-center justify-between gap-4 rounded-lg bg-canard p-6 text-white">
    <div>
      <p class="text-sm opacity-90">Émargement ouvert</p>
      <p class="font-display text-2xl font-bold"><%= today_slot.label %></p>
    </div>
    <%= link_to sign_slot_path(today_slot.sign_token), class: "btn bg-white text-canard hover:bg-signal hover:text-ink" do %><%= icon "pen" %> Signer ma présence<% end %>
  </div>
<% end %>

<section class="panel" aria-labelledby="session-title">
  <h2 id="session-title" class="border-b border-line px-5 py-3 text-lg">Votre session</h2>
  <div class="panel-body">
    <dl class="facts">
      <dt>Lieu</dt>
      <dd>
        <% if (loc = cs.location) %>
          <strong><%= loc.name %></strong><br><%= simple_format_text loc.address %>
          <% if loc.access_details.present? %><p class="mt-1 text-sm text-ink-soft">Accès : <%= loc.access_details %></p><% end %>
          <% if loc.accessibility.present? %><p class="text-sm text-ink-soft">Accessibilité : <%= loc.accessibility %></p><% end %>
        <% else %>À préciser<% end %>
      </dd>
      <% if cs.trainer %><dt>Formateur</dt><dd><%= cs.trainer.full_name %></dd><% end %>
      <dt>Émargement</dt>
      <dd><%= CourseSession::ATTENDANCE_LABELS[cs.attendance_mode] %>
        <% unless cs.attendance_photo? %><span class="block text-sm text-ink-soft">Sans smartphone : signez sur la tablette du formateur avec votre code <strong><%= enrollment.attendance_code %></strong>.</span><% end %></dd>
    </dl>
    <h3 class="mt-6 mb-2">Demi-journées</h3>
    <ul class="divide-y divide-line border-y border-line">
      <% slots.each do |slot| %>
        <% attendance = slot.attendances.find { _1.enrollment_id == enrollment.id } %>
        <li class="flex flex-wrap items-center justify-between gap-2 py-2">
          <span class="inline-flex items-center gap-2"><%= icon "calendar", size: 16 %><%= slot.label %></span>
          <% if attendance && !attendance.pending? %><%= status_badge attendance.status_label, attendance_tone(attendance) %><% elsif slot.closed? %><%= status_badge "Absent", :danger %><% end %>
        </li>
      <% end %>
    </ul>
    <% if enrollment.attended_hours.positive? %><p class="mt-3 text-sm text-ink-soft"><%= hours_count enrollment.attended_hours %> de formation suivies sur <%= hours_count enrollment.planned_hours %>.</p><% end %>
  </div>
</section>

<% if cs.materials.attached? %>
  <section class="panel mt-6" aria-labelledby="supports-title">
    <h2 id="supports-title" class="border-b border-line px-5 py-3 text-lg">Supports de formation</h2>
    <div class="panel-body">
      <% if cs.materials_available? %>
        <ul class="space-y-2">
          <% cs.materials.each do |file| %>
            <li><%= link_to enrollment_material_path(enrollment, file.id), class: "inline-flex items-center gap-2", data: { turbo: false } do %><%= icon "download" %><%= file.filename %> <span class="text-sm text-ink-soft">(<%= number_to_human_size file.byte_size %>)</span><% end %></li>
          <% end %>
        </ul>
        <% if cs.materials_available_until %><p class="mt-3 text-sm text-ink-soft">Disponibles jusqu'au <%= l(cs.materials_available_until, format: :long) %>.</p><% end %>
      <% else %>
        <p class="text-ink-soft">L'accès aux supports (un an après la formation) est terminé.</p>
      <% end %>
    </div>
  </section>
<% end %>
