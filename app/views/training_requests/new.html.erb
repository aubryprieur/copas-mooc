<% page_title "Demander « #{@course.title} » pour ma structure" %>
<section class="container-page py-10">
  <nav class="mb-4 text-sm"><%= link_to @course.title, course_path(@course) %></nav>
  <div class="grid gap-10 lg:grid-cols-[1fr_20rem]">
    <div class="min-w-0">
      <h1>Organiser cette formation pour votre structure</h1>
      <p class="mt-3 text-lg text-ink-soft measure">Décrivez votre groupe et ce que vous attendez de la formation : nous adaptons le déroulé à votre contexte et vous proposons des dates.</p>

      <%= form_with model: @request, url: course_training_request_path(@course), class: "mt-8" do |f| %>
        <%= render "shared/form_errors", record: @request %>
        <fieldset class="mb-10">
          <legend class="mb-4 font-display text-xl font-bold">Votre structure</legend>
          <div class="grid gap-x-4 sm:grid-cols-2">
            <div class="field"><%= f.label :organization_name, "Nom de la structure", class: "label" %><%= f.text_field :organization_name, class: "input", required: true, autocomplete: "organization" %></div>
            <div class="field"><%= f.label :organization_kind, "Type", class: "label" %><%= f.select :organization_kind, User::ORGANIZATION_TYPE_LABELS.except("particulier").invert, {}, class: "input" %></div>
            <div class="field"><%= f.label :contact_name, "Votre nom", class: "label" %><%= f.text_field :contact_name, class: "input", required: true, autocomplete: "name" %></div>
            <div class="field"><%= f.label :contact_role, "Votre fonction", class: "label" %><%= f.text_field :contact_role, class: "input" %></div>
            <div class="field"><%= f.label :contact_email, "Courriel", class: "label" %><%= f.email_field :contact_email, class: "input", required: true, autocomplete: "email" %></div>
            <div class="field"><%= f.label :contact_phone, "Téléphone (facultatif)", class: "label" %><%= f.telephone_field :contact_phone, class: "input", autocomplete: "tel" %></div>
          </div>
        </fieldset>
        <fieldset class="mb-8">
          <legend class="mb-4 font-display text-xl font-bold">Votre besoin</legend>
          <div class="grid gap-x-4 sm:grid-cols-2">
            <div class="field"><%= f.label :participants_count, "Nombre de participants envisagé", class: "label" %><%= f.number_field :participants_count, class: "input", min: 1 %></div>
            <div class="field"><%= f.label :desired_period, "Période souhaitée", class: "label" %><%= f.text_field :desired_period, class: "input", placeholder: "Ex. : mars 2027, deux demi-journées" %></div>
          </div>
          <div class="field"><%= f.label :participants_profile, "Qui sont les participants ?", class: "label" %><%= f.text_area :participants_profile, class: "input", required: true, rows: 3 %><p class="hint">Fonctions, services, niveau d'expérience sur le sujet.</p></div>
          <div class="field"><%= f.label :structure_objectives, "Qu'attendez-vous de cette formation pour votre structure ?", class: "label" %><%= f.text_area :structure_objectives, class: "input", required: true %><p class="hint">Exemple : « Lancer notre premier budget participatif en 2027 avec une équipe projet de 8 agents et élus. »</p></div>
          <div class="field"><%= f.label :constraints, "Contraintes ou points d'attention (facultatif)", class: "label" %><%= f.text_area :constraints, class: "input", rows: 3 %><p class="hint">Calendrier, salle disponible, horaires, contexte particulier.</p></div>
          <label class="field flex items-start gap-3 panel-tint p-4"><%= f.check_box :accessibility_needs, class: "checkbox mt-1" %><span>Un ou plusieurs participants pourraient avoir besoin d'un aménagement (handicap, accessibilité de la salle). Nous en parlerons ensemble.</span></label>
        </fieldset>
        <%= f.submit "Envoyer la demande", class: "btn btn-primary" %>
      <% end %>
    </div>
    <aside class="panel-tint h-fit p-6 text-sm">
      <h2 class="mb-3 text-lg">Ensuite</h2>
      <ol class="journey">
        <li class="is-current"><span class="journey-title">Vous décrivez votre besoin</span></li>
        <li><span class="journey-title">Nous échangeons et vous envoyons une convention ou un devis</span></li>
        <li><span class="journey-title">Vous nous transmettez la liste des participants</span></li>
        <li><span class="journey-title">Chacun reçoit sa convocation et prépare la formation en ligne</span></li>
      </ol>
    </aside>
  </div>
</section>
