<% page_title @lesson.title %>
<div class="container-page py-8" data-controller="heartbeat" data-heartbeat-url-value="<%= heartbeat_enrollment_lesson_path(@enrollment, @lesson) %>">
  <div class="grid gap-8 lg:grid-cols-[1fr_18rem]">
    <article class="min-w-0">
      <nav class="mb-3 text-sm"><%= link_to @course.title, enrollment_path(@enrollment) %> <span aria-hidden="true">/</span> Module <%= @lesson.number %> sur <%= @course.lessons.size %></nav>
      <h1 class="text-3xl"><%= @lesson.title %></h1>
      <p class="mt-2 inline-flex items-center gap-1.5 text-sm text-ink-soft"><%= icon "clock", size: 16 %>Durée moyenne : <%= minutes_label @lesson.estimated_minutes %>
        <% if @lesson.objectives.any? %> · Objectif<%= "s" if @lesson.objectives.size > 1 %> : <%= @lesson.objectives.map(&:position).join(", ") %><% end %></p>

      <% if @lesson.video.attached? %>
        <div class="mt-6 overflow-hidden rounded-lg bg-ink">
          <video controls preload="metadata" class="aspect-video w-full" crossorigin="anonymous">
            <source src="<%= rails_blob_path(@lesson.video) %>" type="<%= @lesson.video.content_type %>">
            <% if @lesson.captions.attached? %>
              <track kind="captions" src="<%= rails_blob_path(@lesson.captions) %>" srclang="fr" label="Français" default>
            <% end %>
            Votre navigateur ne lit pas cette vidéo : <%= link_to "téléchargez-la", rails_blob_path(@lesson.video, disposition: "attachment") %>.
          </video>
        </div>
      <% end %>

      <div class="prose-copas mt-8"><%= @lesson.content %></div>

      <% if @lesson.resources.attached? %>
        <section class="mt-8">
          <h2 class="mb-3 text-lg">Ressources à télécharger</h2>
          <ul class="space-y-2">
            <% @lesson.resources.each do |file| %>
              <li><%= link_to rails_blob_path(file, disposition: "attachment"), class: "inline-flex items-center gap-2" do %><%= icon "file" %><%= file.filename %> <span class="text-sm text-ink-soft">(<%= number_to_human_size file.byte_size %>)</span><% end %></li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
        <%= link_to(enrollment_lesson_path(@enrollment, @lesson.previous_lesson), class: "btn btn-ghost") { icon("arrow-left") + " Module précédent" } if @lesson.previous_lesson %>
        <% if @progress.completed? %>
          <span class="inline-flex items-center gap-2 font-bold text-ok"><%= icon "check" %> Terminé</span>
          <%= link_to(enrollment_lesson_path(@enrollment, @lesson.next_lesson), class: "btn btn-primary") { "Module suivant ".html_safe + icon("arrow-right") } if @lesson.next_lesson %>
        <% else %>
          <%= button_to complete_enrollment_lesson_path(@enrollment, @lesson), class: "btn btn-primary" do %><%= icon "check" %> J'ai terminé ce module<% end %>
        <% end %>
      </div>
    </article>

    <aside class="space-y-6 lg:sticky lg:top-6 lg:self-start">
      <nav aria-label="Modules" class="panel p-2">
        <ol>
          <% @course.lessons.each_with_index do |lesson, i| %>
            <% done = @enrollment.lesson_completed?(lesson) %>
            <li>
              <%= link_to enrollment_lesson_path(@enrollment, lesson),
                    class: "flex items-start gap-2 rounded-md px-3 py-2 text-sm no-underline #{lesson == @lesson ? 'bg-mist font-bold text-ink' : 'text-ink-soft hover:bg-paper'}",
                    aria: { current: (lesson == @lesson ? "page" : nil) } do %>
                <span class="mt-0.5 <%= done ? 'text-ok' : '' %>"><%= icon(done ? "check" : "play", size: 16) %></span>
                <span><%= i + 1 %>. <%= lesson.title %></span>
              <% end %>
            </li>
          <% end %>
        </ol>
      </nav>
      <div class="panel-tint p-4 text-sm">
        <p class="font-bold">Bloqué sur ce module ?</p>
        <p class="mt-1 text-ink-soft">L'équipe pédagogique répond sous 2 jours ouvrés.</p>
        <%= link_to "Poser une question", new_support_thread_path(enrollment_id: @enrollment.id, lesson_id: @lesson.id), class: "btn btn-secondary btn-sm mt-3" %>
      </div>
    </aside>
  </div>
</div>
