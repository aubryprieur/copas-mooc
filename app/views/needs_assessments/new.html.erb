<% page_title "Vos besoins" %>
<section class="container-page py-10">
  <nav class="mb-4 text-sm"><%= link_to @course.title, dashboard_path %></nav>
  <div class="measure">
    <h1 class="text-3xl">Avant la formation : votre poste et vos attentes</h1>
    <p class="mt-3 text-ink-soft">
      <%= @enrollment.course_session&.organization&.name || "Votre structure" %> vous a inscrit(e) à « <%= @course.title %> »<%= ", #{@enrollment.course_session.dates_label}" if @enrollment.course_session %>.
      Vos réponses permettent au formateur d'adapter la formation. Elles ne sont lues que par l'équipe pédagogique de COPAS.
    </p>
    <%= form_with model: @needs, url: enrollment_needs_assessment_path(@enrollment), class: "mt-8" do |f| %>
      <%= render "shared/form_errors", record: @needs %>
      <div class="field"><%= f.label :job_title, "Votre fonction", class: "label" %><%= f.text_field :job_title, class: "input", required: true %></div>
      <div class="field"><%= f.label :work_situations, "Dans quelles situations de travail utiliserez-vous cette formation ?", class: "label" %><%= f.text_area :work_situations, class: "input", required: true %></div>
      <div class="field"><%= f.label :expectations, "Qu'attendez-vous de la formation ?", class: "label" %><%= f.text_area :expectations, class: "input", required: true %></div>
      <div class="field"><%= f.label :prior_experience, "Ce que vous connaissez déjà du sujet (facultatif)", class: "label" %><%= f.text_area :prior_experience, class: "input" %></div>
      <div class="field"><%= f.label :questions, "Une question pour le formateur ? (facultatif)", class: "label" %><%= f.text_area :questions, class: "input", rows: 3 %></div>
      <label class="field flex items-start gap-3 panel-tint p-4">
        <%= f.check_box :accommodation_contact_requested, class: "checkbox mt-1" %>
        <span><strong>Je souhaite être contacté(e) par le référent handicap</strong> pour un aménagement (accès à la salle, supports adaptés, rythme…). <span class="block text-sm text-ink-soft">Rien d'autre n'est enregistré ici.</span></span>
      </label>
      <%= f.submit "Enregistrer et continuer", class: "btn btn-primary" %>
    <% end %>
  </div>
</section>
