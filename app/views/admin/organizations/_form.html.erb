<%= form_with model: [:admin, @organization], class: "panel panel-body measure" do |f| %>
  <%= render "shared/form_errors", record: @organization %>
  <div class="field"><%= f.label :name, "Nom", class: "label" %><%= f.text_field :name, class: "input", required: true %></div>
  <div class="field"><%= f.label :kind, "Type", class: "label" %><%= f.select :kind, User::ORGANIZATION_TYPE_LABELS.except("particulier").invert, {}, class: "input" %></div>
  <div class="grid gap-x-4 sm:grid-cols-2">
    <div class="field"><%= f.label :contact_name, "Contact (formation ou RH)", class: "label" %><%= f.text_field :contact_name, class: "input" %></div>
    <div class="field"><%= f.label :contact_email, "Courriel du contact", class: "label" %><%= f.email_field :contact_email, class: "input" %></div>
  </div>
  <div class="field"><%= f.label :contact_phone, "Téléphone", class: "label" %><%= f.telephone_field :contact_phone, class: "input" %></div>
  <div class="field"><%= f.label :address, "Adresse", class: "label" %><%= f.text_area :address, class: "input", rows: 3 %></div>
  <div class="flex gap-3"><%= f.submit "Enregistrer", class: "btn btn-primary" %><%= link_to "Annuler", admin_organizations_path, class: "btn btn-ghost" %></div>
<% end %>
