<% page_title "Avis de la structure" %>
<section class="container-page py-10">
  <div class="measure">
    <h1 class="text-3xl">Votre avis sur la formation « <%= @course.title %> »</h1>
    <p class="mt-3 text-ink-soft"><%= @session.organization&.name %> · <%= @session.dates_label %>. Deux minutes : vos réponses nous aident à améliorer la formation.</p>
    <%= form_with model: @survey, url: client_survey_path(token: @session.access_token), class: "mt-8" do |f| %>
      <%= render "shared/form_errors", record: @survey %>
      <div class="field"><%= f.label :respondent_name, "Votre nom et fonction", class: "label" %><%= f.text_field :respondent_name, class: "input" %></div>
      <%= render "surveys/scale", f: f, field: :overall_rating, legend: "Globalement, la formation a-t-elle répondu aux besoins de votre structure ?", range: 1..5, required: true, hint: "1 : pas du tout · 5 : tout à fait" %>
      <%= render "surveys/scale", f: f, field: :objectives_rating, legend: "Les objectifs annoncés ont-ils été atteints ?", range: 1..5, required: false, hint: nil %>
      <%= render "surveys/scale", f: f, field: :organization_rating, legend: "Organisation (échanges préalables, convocations, documents)", range: 1..5, required: false, hint: nil %>
      <%= render "surveys/scale", f: f, field: :trainer_rating, legend: "Qualité de l'intervention", range: 1..5, required: false, hint: nil %>
      <div class="field"><%= f.label :observed_effects, "Qu'avez-vous déjà observé chez les participants depuis la formation ? (facultatif)", class: "label" %><%= f.text_area :observed_effects, class: "input" %></div>
      <div class="field"><%= f.label :comment, "Que faudrait-il améliorer ?", class: "label" %><%= f.text_area :comment, class: "input" %></div>
      <%= f.submit "Envoyer l'avis", class: "btn btn-primary" %>
    <% end %>
  </div>
</section>
